# Copy this file to .env and add your key to enable live Claude reports.
ANTHROPIC_API_KEY=

# Change this if Anthropic retires or renames a model.
CLAUDE_MODEL=claude-sonnet-5

# The included 2025 NFLverse file covers all 32 teams.
PLAY_DATA_PATH=data/play_by_play_2025.csv.gz

# Flask settings
FLASK_DEBUG=1
PORT=5000
